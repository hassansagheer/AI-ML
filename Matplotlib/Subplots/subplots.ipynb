   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Creating subplots\n",
    "fig, ax = plt.subplots(3, 3)\n",
    "\n",
    "# Plot random data in each subplot\n",
    "for row in ax:\n",
    "    for col in row:\n",
    "        col.plot(np.random.randint(0, 5, 5), np.random.randint(0, 5, 5))\n",
    "\n",
    "plt.show()"
   ]
  }
 ],
