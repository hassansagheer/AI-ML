   "source": [
    "import matplotlib.pyplot as plt\n",
    "\\\n",
    "x = [1, 2, 3, 4, 5]\n",
    "y = [2, 3, 5, 7, 11]\n",
    "sizes = [30, 80, 150, 200, 300]  # Bubble sizes\n",
    "\n",
    "plt.scatter(x, y, s=sizes, alpha=0.5, edgecolors='blue', linewidths=2)\n",
    "plt.title(\"Bubble Plot Example\")\n",
    "plt.xlabel(\"X-axis\")\n",
    "plt.ylabel(\"Y-axis\")\n",
    "plt.show()"
   ]
  }
 ],
