    "from scipy.optimize import minimize\n",
    "\n",
    "# Function to minimize\n",
    "def f(x):\n",
    "    return (x - 3) ** 2\n",
    "\n",
    "result = minimize(f, x0=0)\n",
    "print(result.x)"
