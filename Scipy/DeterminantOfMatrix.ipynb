   "source": [
    "import numpy as np\n",
    "from scipy.linalg import det\n",
    "\n",
    "matrix = np.array([[1, 2, 3],\n",
    "                   [0, 1, 4],\n",
    "                   [5, 6, 0]])\n",
    "\n",
    "determinant = det(matrix)\n",
    "\n",
    "print(f\"Determinant of the matrix is: {determinant}\")"
   ]
  }
